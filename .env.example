APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

#
# PRODUCTION OVERRIDE CHECKLIST (audit §2.3 / §3.6) — see DEPLOYMENT.md
# The AppServiceProvider refuses to boot in production while APP_DEBUG=true.
#
#   APP_ENV=production
#   APP_DEBUG=false
#   APP_URL=https://your-domain.example
#   SESSION_SECURE_COOKIE=true     ← force HTTPS-only session cookies
#   LOG_LEVEL=warning
#   DB_CONNECTION=mysql            ← real MySQL 8, not sqlite
#   DB_HOST=127.0.0.1
#   DB_PORT=3306
#   DB_DATABASE=ems
#   DB_USERNAME=...
#   DB_PASSWORD=...
#
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Audit §3.6: MUST be set to true in production (HTTPS-only session cookie).
SESSION_SECURE_COOKIE=false

BROADCAST_CONNECTION=log
# Uploaded applicant documents and student ID face photos are stored on the DEFAULT disk
# and read back only through routes that authorize() the owning record. Leave this on the
# private `local` disk: `public` plus `php artisan storage:link` would serve every one of
# them by URL. See DEPLOYMENT.md §2.
FILESYSTEM_DISK=local

# Absolute path to Chrome or Edge, which is what actually draws the printed papers.
# A path set here is honored strictly — if the file is missing the desks are told there is
# no browser, rather than quietly rendering with a different one. Leave unset to search the
# usual install locations. See DEPLOYMENT.md §6.
#EMS_CHROME_PATH=

QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
